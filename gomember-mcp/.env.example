# Kopiér denne fil til ".env" og udfyld - .env må ALDRIG committes til git.

# Login for det fiktive read-only medlem du opretter i goMember
# (Site indstillinger > Rettigheder, se tidligere aftale).
GOMEMBER_USERNAME=
GOMEMBER_PASSWORD=

# Kun nødvendig hvis test-kaldet i README fejler med "invalid_client" -
# swagger-filen dokumenterer ikke om /auth/token kræver client_id.
# GOMEMBER_CLIENT_ID=

# Kan udelades - default er https://www.stronggym.dk
# GOMEMBER_BASE_URL=https://www.stronggym.dk
